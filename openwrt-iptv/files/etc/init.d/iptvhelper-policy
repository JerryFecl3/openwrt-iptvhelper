#!/bin/sh /etc/rc.common
START=19
USE_PROCD=1
start_service() {
    [ "$(uci -q get iptvhelper.main.service_enabled)" = "0" ] && return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/iptvhelper-app/policy.py --watch
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
reload_service() {
    [ "$(uci -q get iptvhelper.main.service_enabled)" = "0" ] && return 0
    /usr/bin/python3 /usr/lib/iptvhelper-app/policy.py
}
service_triggers() { procd_add_reload_trigger iptvhelper; }
# Automatic publication can be disabled while media still needs this policy.
# Stopping this service deliberately retains fail-closed routes/rules.
