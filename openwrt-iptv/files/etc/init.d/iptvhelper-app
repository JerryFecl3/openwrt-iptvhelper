#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
    [ -e /var/run/iptvhelper-removing ] && return 0
    [ "$(uci -q get iptvhelper.main.service_enabled)" = "0" ] && return 0
    /etc/init.d/iptvhelper-policy running || /etc/init.d/iptvhelper-policy start
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/iptvhelper-app/app.py daemon
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
}
service_triggers() { procd_add_reload_trigger iptvhelper; }

